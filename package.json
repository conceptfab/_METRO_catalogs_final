{
  "name": "metro-catalogs",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "images": "node scripts/process-images.mjs",
    "images:force": "node scripts/process-images.mjs --force",
    "deploy:prod": "npm run pdfs && npm run pdfs:optimize && npm run pdfs:verify && vercel --prod --scope=conceptfabs-projects",
    "deploy:preview": "vercel --scope=conceptfabs-projects",
    "vercel:link": "vercel link --yes --project=metro-catalogs --scope=conceptfabs-projects",
    "vercel:env:pull": "vercel env pull .env.local --environment=development --scope=conceptfabs-projects --yes",
    "vercel:env:list": "vercel env ls --scope=conceptfabs-projects",
    "vercel:logs": "vercel logs --scope=conceptfabs-projects",
    "vercel:inspect": "vercel inspect --scope=conceptfabs-projects",
    "vercel:whoami": "vercel whoami",
    "dev:turbo": "next dev --turbopack",
    "prebuild": "npm run images",
    "build": "NEXT_LOCAL_ISOLATED_DIST=1 next build",
    "build:no-images": "NEXT_LOCAL_ISOLATED_DIST=1 next build",
    "clean": "rm -rf .next .next-build node_modules/.cache",
    "start": "NEXT_LOCAL_ISOLATED_DIST=1 next start",
    "recompress:gallery": "node scripts/recompress-gallery-bases.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:images:force": "node scripts/optimize-images.mjs --force",
    "optimize:videos": "node scripts/optimize-videos.mjs",
    "optimize:videos:force": "node scripts/optimize-videos.mjs --force",
    "thumbnails": "node scripts/generate-thumbnails.mjs",
    "thumbnails:force": "node scripts/generate-thumbnails.mjs --force",
    "thumbnails:clean": "node scripts/generate-thumbnails.mjs --clean",
    "audit": "node scripts/catalog-assets.mjs",
    "audit:check": "node scripts/catalog-assets.mjs --check",
    "assets:check": "node scripts/check-no-rasterized-non-webp.mjs",
    "packshots:check": "node scripts/check-packshots.mjs",
    "mrc1000:combinations": "node scripts/generate-mrc1000-combinations.mjs",
    "mrc1000:combinations:force": "node scripts/generate-mrc1000-combinations.mjs --force",
    "pdfs": "node scripts/generate-catalog-pdfs.mjs",
    "pdfs:optimize": "node scripts/optimize-catalog-pdfs.mjs",
    "pdfs:verify": "node scripts/verify-catalog-pdfs.mjs",
    "pdfs:all": "npm run pdfs && npm run pdfs:optimize && npm run pdfs:verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "kill:next": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-next.ps1",
    "kill:next:mac": "lsof -ti:3000-3009 | xargs kill -9 || true"
  },
  "dependencies": {
    "@sparticuz/chromium": "^148.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.462.0",
    "next": "15.5.12",
    "puppeteer-core": "^25.0.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "19.2.9",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.12",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.2",
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "samsung >= 21",
    "and_chr >= 100",
    "not dead",
    "not op_mini all"
  ]
}