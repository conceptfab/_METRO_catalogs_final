{
  "$metadata": {
    "tokenSetOrder": ["core", "light", "dark", "typography"]
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled",
        "typography": "enabled"
      }
    },
    {
      "id": "dark",
